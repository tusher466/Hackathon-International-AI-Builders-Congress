# Factory Brain Environment Variables
# Copy to .env and adjust

# General
ENV=development
LOG_LEVEL=INFO
# Optional API key for protecting endpoints (X-API-Key header)
API_KEY=
CORS_ORIGINS=*

# Streaming
# Options: mqtt | memory (default memory runs without Docker)
STREAM_BACKEND=memory
SIM_RATE_HZ=2.0
AUTO_START_STREAM=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=factory
MQTT_CLIENT_ID=factory-brain

# LLM
# LLM_MODE: mock | real. mock returns deterministic responses offline
LLM_MODE=mock
# If using real Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_RETRIES=2

# Storage
DATABASE_URL=sqlite:///./data/factory_brain.db
CHROMA_PERSIST_PATH=./data/chroma
CHROMA_COLLECTION_NAME=manuals
EMBEDDING_MODEL=all-MiniLM-L6-v2
RING_BUFFER_SIZE=500
MODELS_DIR=./models

# Detection Thresholds
ANOMALY_THRESHOLD_LOW=0.3
ANOMALY_THRESHOLD_MEDIUM=0.5
ANOMALY_THRESHOLD_HIGH=0.7
ANOMALY_THRESHOLD_CRITICAL=0.85

RUL_CRITICAL=20
RUL_HIGH=50
RUL_MEDIUM=100

DEFECT_PROB_LOW=0.3
DEFECT_PROB_MEDIUM=0.5
DEFECT_PROB_HIGH=0.7
DEFECT_PROB_CRITICAL=0.85

ALERT_COOLDOWN_READINGS=10
FEATURE_WINDOW_SIZE=30

# Health Score Weights (sum to 1.0)
HEALTH_WEIGHT_ANOMALY=0.4
HEALTH_WEIGHT_RUL=0.35
HEALTH_WEIGHT_DEFECT=0.15
HEALTH_WEIGHT_ALERTS=0.1
HEALTH_OFFLINE_THRESHOLD_READINGS=50

# Agent
MAX_CONCURRENT_AGENT_RUNS=5
MAX_AGENT_ITERATIONS=8
RETRIEVAL_K=5
RETRIEVAL_SCORE_THRESHOLD=0.1

# Actions
WEBHOOK_URL=

# Demo
DEMO_FAULT_MACHINE=TURBO-01
