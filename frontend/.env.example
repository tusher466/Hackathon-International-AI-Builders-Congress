# Frontend Environment Variables
# Copy to .env and adjust

# Backend API base - for local dev use http://localhost:8000/api/v1
# For production merged deployment (backend serves frontend), use /api/v1 or leave empty for auto-detect
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL - backend WS endpoint
# Supports both /ws/live (recommended) and /api/v1/ws/live (legacy alias)
VITE_WS_URL=ws://localhost:8000/ws/live

# Optional API key if backend API_KEY is set
VITE_API_KEY=

# Mock mode: true = use built-in mock data when backend unreachable (recommended for demo without backend)
# false = always use real backend, will show error if backend down
VITE_USE_MOCK=false

# For production deployment where frontend and backend same origin, you can use:
# VITE_API_BASE_URL=/api/v1
# VITE_WS_URL=/ws/live  (will be auto-converted to ws:// or wss:// based on page protocol)
